generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  occasions    Occasion[]
  photos       Photo[]
}

model Occasion {
  id          String   @id @default(cuid())
  name        String
  description String?
  date        DateTime
  accessCode  String   @unique
  coverImage  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos      Photo[]

  @@index([accessCode])
  @@index([userId])
}

model Photo {
  id              String           @id @default(cuid())
  fileName        String
  originalPath    String
  thumbnailPath   String?
  fileSize        Int
  mimeType        String
  width           Int?
  height          Int?
  faceProcessed   Boolean          @default(false)
  createdAt       DateTime         @default(now())
  occasionId      String
  occasion        Occasion         @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  uploadedById    String
  uploadedBy      User             @relation(fields: [uploadedById], references: [id])
  faceDescriptors FaceDescriptor[]

  @@index([occasionId])
  @@index([uploadedById])
}

model FaceDescriptor {
  id         String @id @default(cuid())
  descriptor String // JSON string of Float32Array (128 values)
  x          Float  // bounding box
  y          Float
  width      Float
  height     Float
  photoId    String
  photo      Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([photoId])
}
