# ==============================================================================
# SnapShare Environment Configuration
# ==============================================================================

# 1. DATABASE (Required)
# For Local Dev:
# DATABASE_URL="file:./dev.db"
#
# For Production (Neon, Supabase, or Vercel Postgres):
# DATABASE_URL="postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/snapshare?sslmode=require"
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# 2. NEXTAUTH (Required)
# Generate a random secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-generated-random-nextauth-secret"
# In Production on Vercel, set to your live domain e.g. https://snapshare.vercel.app
NEXTAUTH_URL="https://your-domain.vercel.app"

# 3. PHOTO STORAGE (Cloudflare R2, AWS S3, or Supabase Storage)
# If left empty, SnapShare falls back to local ./uploads directory (dev only).
# In production on Vercel, S3-compatible cloud storage is REQUIRED for persistent images.
S3_BUCKET_NAME="snapshare-photos"
S3_REGION="auto" # use "auto" for Cloudflare R2, or "us-east-1" for AWS S3
S3_ACCESS_KEY_ID="your-s3-or-r2-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-or-r2-secret-access-key"

# For Cloudflare R2:
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_FORCE_PATH_STYLE="false"

# For Supabase Storage S3-compatible API:
# S3_ENDPOINT="https://<project-ref>.supabase.co/storage/v1/s3"
# S3_FORCE_PATH_STYLE="true"

# 4. EMAIL DELIVERY (Optional — via Resend API)
# If set, guest photo packs are emailed directly. Otherwise, SnapShare generates
# a permanent shareable pack link + mailto fallback.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="SnapShare <photos@yourdomain.com>"

# Maximum upload file size in bytes (default 50MB)
MAX_FILE_SIZE="52428800"
